# Copy to `.env.local` for local development. Never commit real values.

# --- Client (baked into the bundle at build time; assume public) ---

# Where the Join form POSTs. Defaults to the same-origin /api/join function,
# which the existing `connect-src 'self'` CSP already allows. Only set this to
# override; a CROSS-ORIGIN value must also be added to `connect-src` in
# vercel.json or the browser will block the request.
# VITE_JOIN_ENDPOINT=

# A mailbox the project VERIFIABLY CONTROLS, shown to students as a manual
# fallback if a submission fails. Leave unset until ownership is confirmed —
# an address on someone else's domain sends student PII to that organization.
# VITE_CONTACT_EMAIL=

# --- Server (api/join.ts; never exposed to the browser) ---

# Resend API key. Without it /api/join returns 503 and the form shows its
# copy-and-paste fallback instead of claiming a submission was delivered.
RESEND_API_KEY=

# The inbox that receives Join submissions. Required alongside RESEND_API_KEY.
JOIN_NOTIFY_EMAIL=

# Optional sender. Must be on a Resend-verified domain; defaults to Resend's
# shared onboarding@resend.dev sandbox address.
JOIN_FROM_EMAIL=
